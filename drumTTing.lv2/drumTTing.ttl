@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

<urn:asier:lv2:drumtting>
    a lv2:Plugin, lv2:InstrumentPlugin ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/urid#map> ;
    doap:name "drumTTing" ;
    doap:license "GPL-2.0-only" ;
    doap:maintainer [ foaf:name "TTLab" ] ;
    mod:brand "TTLab" ;
    mod:label "drumTTing" ;
    lv2:minorVersion 0 ;
    lv2:microVersion 1 ;

    lv2:port
    [ a atom:AtomPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ; lv2:designation lv2:control ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ] ,
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out_l" ; lv2:name "Out L" ] ,
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out_r" ; lv2:name "Out R" ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "vco_wave" ; lv2:name "VCO_Wave" ; lv2:default 0.25 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "vco_oct" ; lv2:name "VCO_Oct" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum -3 ; lv2:maximum 3 ;
      lv2:scalePoint [ rdfs:label "-3" ; rdf:value -3 ] , [ rdfs:label "-2" ; rdf:value -2 ] , [ rdfs:label "-1" ; rdf:value -1 ] , [ rdfs:label "0" ; rdf:value 0 ] , [ rdfs:label "1" ; rdf:value 1 ] , [ rdfs:label "2" ; rdf:value 2 ] , [ rdfs:label "3" ; rdf:value 3 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "vco_pitch" ; lv2:name "VCO_Pitch" ; lv2:portProperty pprops:logarithmic ; lv2:default 55.00 ; lv2:minimum 20.00 ; lv2:maximum 5000.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "vco_range" ; lv2:name "VCO_Range" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
      lv2:scalePoint [ rdfs:label "Low" ; rdf:value 0 ] , [ rdfs:label "High" ; rdf:value 1 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "vco_pbend" ; lv2:name "VCO_PBend" ; lv2:default 36.00 ; lv2:minimum -48.00 ; lv2:maximum 48.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "vco_penv" ; lv2:name "VCO_PEnv" ; lv2:portProperty pprops:logarithmic ; lv2:default 45.00 ; lv2:minimum 0.50 ; lv2:maximum 3000.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "vco_decay" ; lv2:name "VCO_Decay" ; lv2:portProperty pprops:logarithmic ; lv2:default 700.00 ; lv2:minimum 1.00 ; lv2:maximum 5000.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "vco_5th" ; lv2:name "VCO_5th" ; lv2:portProperty lv2:integer, lv2:toggled ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "fm_intensity" ; lv2:name "FM_Intensity" ; lv2:default 0.00 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "fm_frequency" ; lv2:name "FM_Frequency" ; lv2:portProperty pprops:logarithmic ; lv2:default 100.00 ; lv2:minimum 0.10 ; lv2:maximum 8000.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "fm_phase_reset" ; lv2:name "FM_Phase_Reset" ; lv2:portProperty lv2:integer, lv2:toggled ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 14 ; lv2:symbol "vcf_type" ; lv2:name "VCF_Type" ; lv2:default 0.00 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ;
      lv2:scalePoint [ rdfs:label "LowPass" ; rdf:value 0.00 ] , [ rdfs:label "BandPass" ; rdf:value 0.50 ] , [ rdfs:label "HighPass" ; rdf:value 1.00 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 15 ; lv2:symbol "vcf_cutoff" ; lv2:name "VCF_Cutoff" ; lv2:portProperty pprops:logarithmic ; lv2:default 12000.00 ; lv2:minimum 20.00 ; lv2:maximum 20000.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 16 ; lv2:symbol "vcf_resonance" ; lv2:name "VCF_Resonance" ; lv2:default 0.10 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 17 ; lv2:symbol "vcf_bend" ; lv2:name "VCF_Bend" ; lv2:default 0.00 ; lv2:minimum -48.00 ; lv2:maximum 48.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 18 ; lv2:symbol "vcf_env_time" ; lv2:name "VCF_Env_Time" ; lv2:portProperty pprops:logarithmic ; lv2:default 100.00 ; lv2:minimum 0.50 ; lv2:maximum 5000.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 19 ; lv2:symbol "click_style" ; lv2:name "CLICK_Style" ; lv2:default 0.40 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 20 ; lv2:symbol "click_level" ; lv2:name "CLICK_Level" ; lv2:default 0.60 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 21 ; lv2:symbol "noise_color" ; lv2:name "NOISE_Color" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
      lv2:scalePoint [ rdfs:label "Pink" ; rdf:value 0 ] , [ rdfs:label "Blue" ; rdf:value 1 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 22 ; lv2:symbol "noise_decay" ; lv2:name "NOISE_Decay" ; lv2:portProperty pprops:logarithmic ; lv2:default 80.00 ; lv2:minimum 1.00 ; lv2:maximum 5000.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 23 ; lv2:symbol "noise_level" ; lv2:name "NOISE_Level" ; lv2:default 0.00 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 24 ; lv2:symbol "mix_vco" ; lv2:name "MIX_VCO" ; lv2:default 0.90 ; lv2:minimum -1.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 25 ; lv2:symbol "mix_click" ; lv2:name "MIX_Click" ; lv2:default 0.25 ; lv2:minimum -1.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 26 ; lv2:symbol "mix_noise" ; lv2:name "MIX_Noise" ; lv2:default 0.00 ; lv2:minimum -1.00 ; lv2:maximum 1.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 27 ; lv2:symbol "vca_decay" ; lv2:name "VCA_Decay" ; lv2:portProperty pprops:logarithmic ; lv2:default 700.00 ; lv2:minimum 1.00 ; lv2:maximum 8000.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 28 ; lv2:symbol "drive" ; lv2:name "DRIVE" ; lv2:default 0.25 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 29 ; lv2:symbol "gain" ; lv2:name "GAIN" ; lv2:default -3.00 ; lv2:minimum -24.00 ; lv2:maximum 12.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 30 ; lv2:symbol "vel_amount" ; lv2:name "VEL_AMOUNT" ; lv2:default 0.70 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 31 ; lv2:symbol "comp" ; lv2:name "COMPRESSOR" ; lv2:default 0.00 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 32 ; lv2:symbol "clip" ; lv2:name "CLIP" ; lv2:default 0.00 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] .
